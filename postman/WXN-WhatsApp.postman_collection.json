{
  "info": {
    "name": "WXN — Primeiro atendimento WhatsApp",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "WXN local: execute seed-local-users.mjs e configure loginUsername/loginPassword e a chave de desenvolvimento. A sessão usa cookies e X-CSRF-Token. Cadastro de HUMAN via /api/users com identidade completa."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4001"
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "humanMemberId",
      "value": ""
    },
    {
      "key": "botMemberId",
      "value": ""
    },
    {
      "key": "mockChannelId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "inboundMessageId",
      "value": ""
    },
    {
      "key": "mockExternalId",
      "value": "postman-inbound-001"
    },
    {
      "key": "twilioChannelId",
      "value": ""
    },
    {
      "key": "twilioConversationId",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "loginUsername",
      "value": ""
    },
    {
      "key": "loginPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Sessão e login",
      "item": [
        {
          "name": "Obter cookie de sessão e CSRF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar com usuário ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fluxo Mock (sem chamadas externas)",
      "item": [
        {
          "name": "Criar setor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suporte\",\n  \"color\": \"#2563EB\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('departmentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Consultar usuários (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "03 Selecionar atendente existente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/members"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const attendant = pm.response.json().find(member => member.type === 'HUMAN' && member.status === 'ACTIVE' && member.accountStatus === 'ACTIVE');",
                  "pm.test('Atendente ativo cadastrado', () => pm.expect(attendant).to.exist);",
                  "if (attendant) { pm.collectionVariables.set('humanMemberId', attendant.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Criar membro BOT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Assistente\",\n  \"type\": \"BOT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('botMemberId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Criar canal MOCK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/whatsapp/channels",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mock local\",\n  \"provider\": \"MOCK\",\n  \"phoneNumber\": \"+14155238886\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('mockChannelId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Simular recebimento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dev/whatsapp/mock/inbound",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"{{mockChannelId}}\",\n  \"externalMessageId\": \"{{mockExternalId}}\",\n  \"senderPhone\": \"{{contactPhone}}\",\n  \"content\": \"Olá, preciso de atendimento\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json(); pm.collectionVariables.set('conversationId', body.conversationId); pm.collectionVariables.set('inboundMessageId', body.id);",
                  "pm.test('Inbound normalizado', () => { pm.expect(body.direction).to.eql('INBOUND'); pm.expect(body.status).to.eql('RECEIVED'); pm.expect(body.simulated).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Repetir recebimento (idempotência)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dev/whatsapp/mock/inbound",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"{{mockChannelId}}\",\n  \"externalMessageId\": \"{{mockExternalId}}\",\n  \"senderPhone\": \"{{contactPhone}}\",\n  \"content\": \"Olá, preciso de atendimento\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mesmo ID interno', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('inboundMessageId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Consultar conversas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "09 Consultar mensagens",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Uma mensagem', () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Responder como humano",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"{{mockChannelId}}\",\n  \"memberId\": \"{{humanMemberId}}\",\n  \"content\": \"Resposta do atendente\",\n  \"operationId\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Roteamento MOCK e simulação explícita', () => { const b = pm.response.json(); pm.expect(b.provider).to.eql('MOCK'); pm.expect(b.status).to.eql('SIMULATED'); pm.expect(b.simulated).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Responder como bot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"{{mockChannelId}}\",\n  \"memberId\": \"{{botMemberId}}\",\n  \"content\": \"Resposta do bot sem IA\",\n  \"operationId\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Roteamento MOCK e simulação explícita', () => { const b = pm.response.json(); pm.expect(b.provider).to.eql('MOCK'); pm.expect(b.status).to.eql('SIMULATED'); pm.expect(b.simulated).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Histórico atualizado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Histórico unificado com três mensagens', () => pm.expect(pm.response.json()).to.have.lengthOf(3));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Twilio (execução manual com credenciais reais)",
      "item": [
        {
          "name": "13 Cadastrar canal TWILIO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/whatsapp/channels",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Twilio Sandbox\",\n  \"provider\": \"TWILIO\",\n  \"phoneNumber\": \"{{twilioPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('twilioChannelId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Consultar conversas após webhook real",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().find(c => c.channelId == pm.collectionVariables.get('twilioChannelId')); if (c) pm.collectionVariables.set('twilioConversationId', c.id); pm.test('Conversa recebida no Twilio', () => pm.expect(c).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "15 Enviar resposta REAL via Twilio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{twilioConversationId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"{{twilioChannelId}}\",\n  \"memberId\": \"{{humanMemberId}}\",\n  \"content\": \"Resposta pelo Twilio Sandbox\",\n  \"operationId\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Envio real aceito', () => { const b = pm.response.json(); pm.expect(b.provider).to.eql('TWILIO'); pm.expect(b.simulated).to.eql(false); pm.expect(b.status).to.not.eql('FAILED'); pm.expect(b.externalMessageId).to.match(/^SM/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "16 Histórico e callbacks Twilio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Api-Key",
                "value": "{{devApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{twilioConversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
