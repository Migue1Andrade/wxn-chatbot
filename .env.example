# PostgreSQL
POSTGRES_DB=wxn_chatbot
POSTGRES_USER=wxn_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=4003
POSTGRES_URL=jdbc:postgresql://localhost:4003/wxn_chatbot

# MongoDB
MONGO_DB=wxn_chatbot
MONGO_PORT=4004
MONGODB_URI=mongodb://localhost:4004/wxn_chatbot

# Frontend
BACKEND_PORT=4001
FRONTEND_PORT=4002
FRONTEND_ORIGIN=http://localhost:4002
VITE_API_BASE_URL=http://localhost:4001
VITE_WS_URL=ws://localhost:4001/ws
# Browser development key must match DEV_API_KEY; exposed in the development bundle.
VITE_DEV_API_KEY=
# Local presentation only: true opens the existing login without requiring WhatsApp QR setup.
VITE_SKIP_WHATSAPP_SETUP=false
# Optional: existing WXN-exclusive volume names; verify ownership before any reset.
# POSTGRES_VOLUME=wxn-chatbot_postgres_data
# MONGO_VOLUME=wxn-chatbot_mongo_data

# Internal endpoints and Mock are enabled only in dev, never with prod active.
SPRING_PROFILES_ACTIVE=dev
# Set a unique local key with at least 32 characters. No default key is accepted.
DEV_API_KEY=

# Set true only when both configured volume names already exist.
DATABASE_VOLUMES_EXTERNAL=false

# Evolution API v2.3.7 + Baileys. Keep the API key and bootstrap token private.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=wxn-local
# Public HTTPS URL of the Spring Boot webhook, without trailing slash.
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=
# The all-in-Docker profile uses an internal HTTP webhook; host-only runs should keep HTTPS.
EVOLUTION_ALLOW_HTTP=false
# Used only while the first local WhatsApp setup is pending.
WXN_BOOTSTRAP_TOKEN=
# Credentials used only by the explicit local presentation seed script.
WXN_SEED_USERNAME=
WXN_SEED_PASSWORD=
WXN_DEMO_PASSWORD=
# Separate Evolution database/storage; these values are consumed by compose.yaml.
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_PORT=8080
