# PostgreSQL
POSTGRES_DB=wxn_chatbot
POSTGRES_USER=wxn_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=4003
POSTGRES_URL=jdbc:postgresql://localhost:4003/wxn_chatbot

# MongoDB
MONGO_DB=wxn_chatbot
MONGO_PORT=4004
MONGODB_URI=mongodb://localhost:4004/wxn_chatbot

# Frontend
BACKEND_PORT=4001
FRONTEND_PORT=4002
FRONTEND_ORIGIN=http://localhost:4002
VITE_API_BASE_URL=http://localhost:4001
VITE_WS_URL=ws://localhost:4001/ws
DEV_COMPANY_ID=1
VITE_DEV_COMPANY_ID=1
# Browser development key must match DEV_API_KEY; exposed in the development bundle.
VITE_DEV_API_KEY=
# Optional: existing Docker volume names when reusing preserved data.
# POSTGRES_VOLUME=wxn-chatbot_postgres_data
# MONGO_VOLUME=wxn-chatbot_mongo_data

# Internal endpoints and Mock are enabled only in dev, never with prod active.
SPRING_PROFILES_ACTIVE=dev
# Set a unique local key with at least 32 characters. No default key is accepted.
DEV_API_KEY=

# One explicitly mapped Twilio account/channel in this initial version.
# Obtain company/channel IDs via Postman, then configure and restart backend.
TWILIO_COMPANY_ID=0
TWILIO_CHANNEL_ID=0
TWILIO_CHANNEL_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# HTTPS ngrok origin, no trailing slash or query parameters.
TWILIO_PUBLIC_BASE_URL=

# Set true only when both configured volume names already exist.
DATABASE_VOLUMES_EXTERNAL=false
