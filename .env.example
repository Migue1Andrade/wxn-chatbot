# Databases
# PostgreSQL
# MongoDB
# Set true only when both configured volume names already exist.
POSTGRES_DB=wxn_chatbot
POSTGRES_USER=wxn_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=4003
POSTGRES_URL=jdbc:postgresql://localhost:4003/wxn_chatbot
MONGO_DB=wxn_chatbot
MONGO_PORT=4004
MONGODB_URI=mongodb://localhost:4004/wxn_chatbot
DATABASE_VOLUMES_EXTERNAL=false

# Application
# Frontend
# Browser development key must match DEV_API_KEY; exposed in the development bundle.
# Local presentation only: true opens the existing login without requiring WhatsApp QR setup.
# Internal endpoints and Mock are enabled only in dev, never with prod active.
BACKEND_PORT=4001
FRONTEND_PORT=4002
FRONTEND_ORIGIN=http://localhost:4002
VITE_API_BASE_URL=http://localhost:4001
VITE_WS_URL=ws://localhost:4001/ws
VITE_DEV_API_KEY=
VITE_SKIP_WHATSAPP_SETUP=false
SPRING_PROFILES_ACTIVE=dev

# Local security
# Set a unique local key with at least 32 characters. No default key is accepted.
# Used only while the first local WhatsApp setup is pending.
DEV_API_KEY=
WXN_BOOTSTRAP_TOKEN=

# WhatsApp · Evolution API
# Evolution API v2.3.7 + Baileys. Keep the API key and bootstrap token private.
# Public HTTPS URL of the Spring Boot webhook, without trailing slash.
# The all-in-Docker profile uses an internal HTTP webhook; host-only runs should keep HTTPS.
# Separate Evolution database/storage; these values are consumed by compose.yaml.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=wxn-local
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_ALLOW_HTTP=false
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_PORT=8080

# Local demo data
# Credentials used only by the explicit local presentation seed script.
WXN_SEED_USERNAME=
WXN_SEED_PASSWORD=
WXN_DEMO_PASSWORD=

# Password recovery email
# Password recovery: only local Mailpit by default; configure a trusted HTTPS URL for real use.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
PASSWORD_RESET_PUBLIC_URL=http://localhost:4002/#!/reset-password
PASSWORD_RESET_FROM=no-reply@wxn.local
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# OpenBot integration
# OpenBot WXN Carros piloto (desativado por padrão)
OPENBOT_SUPPORT_ENABLED=false
OPENBOT_SUPPORT_WEBHOOK_URL=
OPENBOT_SUPPORT_SERVICE_TOKEN=
OPENBOT_SUPPORT_HMAC_SECRET=
OPENBOT_SUPPORT_AUTO_ASSIGN_BOT_ID=
OPENBOT_SUPPORT_AUTO_ASSIGN_CHANNEL_ID=

# AutoGuia RAG (opt-in; disabled unless explicitly enabled)
# Use isolated test data first. Embedding provider/model/dimension must match the index.
AUTOGUIA_RAG_ENABLED=false
AUTOGUIA_EMBEDDING_ENABLED=false
AUTOGUIA_EMBEDDING_PROVIDER=
AUTOGUIA_EMBEDDING_MODEL=
AUTOGUIA_EMBEDDING_DIMENSION=0
AUTOGUIA_EMBEDDING_ENDPOINT=
AUTOGUIA_EMBEDDING_API_KEY=
AUTOGUIA_EMBEDDING_CONNECT_TIMEOUT=PT3S
AUTOGUIA_EMBEDDING_TIMEOUT=PT15S
AUTOGUIA_INDEXING_ENABLED=false
AUTOGUIA_INDEXING_DELAY=PT5S
AUTOGUIA_INDEXING_LEASE=PT180S
AUTOGUIA_GENERATION_ENABLED=false
AUTOGUIA_GENERATION_ENDPOINT=
AUTOGUIA_GENERATION_MODEL=
AUTOGUIA_GENERATION_API_KEY=
AUTOGUIA_GENERATION_CONNECT_TIMEOUT=PT3S
AUTOGUIA_GENERATION_TIMEOUT=PT45S
AUTOGUIA_RETRIEVAL_MINIMUM_SIMILARITY=0.25
