FROM node:22-alpine AS build

WORKDIR /workspace
COPY frontend/package*.json ./frontend/
RUN npm --prefix frontend ci
COPY frontend ./frontend

ARG VITE_API_BASE_URL=http://localhost:4001
ARG VITE_WS_URL=ws://localhost:4001/ws
ARG VITE_DEV_API_KEY=
ARG VITE_SKIP_WHATSAPP_SETUP=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_DEV_API_KEY=$VITE_DEV_API_KEY
ENV VITE_SKIP_WHATSAPP_SETUP=$VITE_SKIP_WHATSAPP_SETUP

RUN npm --prefix frontend run build

FROM nginx:1.27-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html
EXPOSE 80
